{
  "name": "quanta-terminal",
  "version": "0.7.0",
  "description": "QUANTA \u2014 AI-native Linux terminal in the browser: 117 real commands, multi-provider AI routing (OmniRoute), security toolkit, persistent VFS.",
  "author": "MAYANK (qtjg)",
  "license": "MIT",
  "homepage": "https://github.com/qtjg/quanta-terminal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qtjg/quanta-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/qtjg/quanta-terminal/issues"
  },
  "keywords": [
    "terminal",
    "ai",
    "linux",
    "nextjs",
    "llm",
    "omniroute",
    "openrouter",
    "groq",
    "security-tools",
    "vfs"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "bun scripts/test-quanta.ts"
  },
  "dependencies": {
    "lucide-react": "0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "tailwindcss-animate": "1.0.7",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}